# ==============================================================================
# AROVEXA - Smart Healthcare Management System
# Comprehensive Root Git Ignore Rules
# ==============================================================================

# 1. Dependency Directories
node_modules/
*/node_modules/
**/node_modules/
.pnpm-store/

# 2. Production Build Artifacts & Distribution Bundles
dist/
dist-ssr/
build/
out/
.next/
*.tsbuildinfo

# 3. Environment & Configuration Secrets
# Exclude all actual secret environment files while allowing safe templates
.env
.env.*
*.env
*.env.local
.env.local
.env.development.local
.env.test.local
.env.production.local
# Explicitly allow safe example templates containing only non-sensitive placeholders
!.env.example
!**/.env.example

# 4. Logs, Debugging & Crash Reports
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 5. Operating System & Filesystem Junk
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# 6. IDEs, Text Editors & Workspace Settings
# Ignore editor workspace noise while allowing shared IDE configuration if needed
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swo
*.swp
*~
.project
.classpath
.settings/

# 7. Testing, Coverage & Diagnostic Reports
coverage/
*.lcov
.nyc_output/
/reports/
test-results/
playwright-report/

# 8. Caches & Temporary Storage
.cache/
.parcel-cache/
.turbo/
.eslintcache
.stylelintcache
/tmp/
/temp/
*.tmp
*.bak

# 9. Cryptographic Keys, Certificates, Tokens & Local Databases
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.sqlite
*.sqlite3
*.db
